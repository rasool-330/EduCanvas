rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.college
           == resource.data.college
      );
      allow write: if request.auth.uid == uid;
    }

    match /topic_completions/{completionId} {
      allow create: if request.auth != null
        && request.resource.data.studentId == request.auth.uid;

      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid
        || (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher"
          && get(/databases/$(database)/documents/curricula/$(resource.data.curriculumId)).data.teacherId
             == request.auth.uid
        )
      );

      allow update, delete: if false;
    }

    match /curricula/{curriculumId} {
      allow create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.college
           == request.resource.data.college;

      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.college
           == resource.data.college
        && (
          resource.data.isPublished == true
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher"
            && resource.data.teacherId == request.auth.uid
          )
        );
    }

    match /enrollments/{curriculumId}/students/{uid} {
      allow write: if request.auth.uid == uid;
      allow read: if request.auth != null;
    }

    match /teacherHistory/{uid}/entries/{entryId} {
      allow read, write: if request.auth.uid == uid;
    }

    match /studentHistory/{uid}/entries/{entryId} {
      allow read, write: if request.auth.uid == uid;
    }
  }
}
